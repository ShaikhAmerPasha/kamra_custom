+/** Out of Order asks why and until when (Kamra Custom); `asked` says the caller has a hold with both already. */
+export const setHousekeepingStatus = async (room: string, status: string, opts?: { asked?: boolean }) => {
+  if (status === "Out of Order" && !opts?.asked && oooListening()) {
+    const a = await askOutOfOrder(room)
+    // the desk closed the form: nothing changes
+    if (!a) return { ok: true, room, status: "" }
+    return call("kamra_custom.rooms.take_out_of_order", { room, reason: a.reason, until: a.until })
+  }
+  return call("kamra.api.set_housekeeping_status", { room, status })
+}
 
