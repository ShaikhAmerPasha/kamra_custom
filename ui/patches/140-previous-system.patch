 function translated(source: string, language: string): string {
+  // a person who used another system sees its word for this label (English only)
+  if (language === "en") {
+    const word = vocabularyWord(source)
+    if (word) return word
+  }
   const dictionary = dictionaryFor(language)
   return Object.hasOwn(dictionary, source) ? dictionary[source] : source.replace(/^[a-z]+\|/, "")
 }
